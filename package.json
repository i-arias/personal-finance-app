{
	"name": "personal-finance",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"deploy": "npm run build && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:accounts:local": "wrangler d1 execute DB --local --file scripts/accounts.local.sql",
		"db:accounts:remote": "wrangler d1 execute DB --remote --file scripts/accounts.local.sql",
		"db:seed:demo": "wrangler d1 execute DB --local --file scripts/demo-seed.sql"
	},
	"dependencies": {
		"hono": "4.13.11",
		"jose": "6.2.12",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-is": "19.3.0",
		"react-router": "8.4.0",
		"recharts": "3.10.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.62.1",
		"@cloudflare/vitest-plugin": "1.3.2",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"wrangler": "4.143.1"
	}
}
